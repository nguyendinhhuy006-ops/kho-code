{
  "name": "quantri-kpi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "node server/index.ts",
    "setup": "node server/index.ts --initialize-only",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "test": "vitest run src/shared/domain.test.ts --configLoader native",
    "test:e2e": "playwright test",
    "test:api": "node scripts/test-api-v1.mjs",
    "db:start": "node scripts/sqlserver-check.mjs",
    "db:check": "node scripts/sqlserver-check.mjs",
    "db:migrate": "node scripts/migrate-postgres-to-sqlserver.mjs",
    "db:postgres:start": "node scripts/postgres-local.mjs start",
    "db:postgres:stop": "node scripts/postgres-local.mjs stop",
    "db:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "test:migration": "node scripts/test-sqlserver-migration.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.0.0",
    "msnodesqlv8": "^6.2.2",
    "mssql": "^12.7.13",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.6.0-beta.19"
  }
}
